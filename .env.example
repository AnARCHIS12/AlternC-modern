# ==============================================================================
# AlternC - Configuration Docker & Séparation des Ports
# ==============================================================================

# Ports d'écoute sur la machine hôte (évite les conflits avec 80, 443 et 3306)
ALTERNC_HTTP_PORT=8080
ALTERNC_HTTPS_PORT=8443
ALTERNC_MYSQL_PORT=3307

# Interfaces réseau (0.0.0.0 = public, 127.0.0.1 = boucle locale / reverse proxy)
ALTERNC_BIND_IP=0.0.0.0
ALTERNC_DB_BIND_IP=127.0.0.1

# Nom de domaine / FQDN
ALTERNC_FQDN=localhost

# Compte administrateur du panel web AlternC
ALTERNC_ADMIN_USER=admin
ALTERNC_ADMIN_PASS=admin123456

# Base de données MariaDB
DB_NAME=alternc
DB_USER=alternc
DB_PASS=alternc_db_pass_change_me
DB_ROOT_PASS=alternc_root_pass_change_me
